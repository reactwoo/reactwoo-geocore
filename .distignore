# WordPress.org package exclusions. Used by:
#   python scripts/package_zip.py --target wporg
# The ReactWoo release zip (no --target, or --target reactwoo) does not read this file.

# Version control, agent, and CI
.git
.github
.cursor
ai-handoff

# WordPress.org directory assets (icon, banner, screenshots). Not part of either plugin zip.
.wordpress-org

# Docs, tests, and maintainer tooling (not needed to run the plugin)
docs
tests
scripts
node_modules

# PHPUnit / Composer dev trees if a maintainer packaged before --no-dev
vendor/bin
vendor/phpunit
vendor/phar-io
vendor/nikic
vendor/myclabs
vendor/sebastian
vendor/theseer
vendor/doctrine

# Library examples, nested tests, docs, and maintainer scripts.
# Composer autoload does not reference these. WordPress.org also rejects .sh files.
vendor/**/examples
vendor/**/example
vendor/**/test
vendor/**/tests
vendor/**/docs
vendor/**/dev-bin
vendor/**/.github
vendor/**/.git
vendor/**/.svn
vendor/**/.hg
vendor/**/.bzr

# Project manifests. The WordPress.org zip includes composer.json (Plugin Check
# warns when vendor/ is present without it). composer.lock stays out.
composer.lock
package.json
package-lock.json
pyproject.toml
phpunit.xml
phpunit.xml.dist
phpcs.xml
phpcs.xml.dist
phpcs.xml.dist.example

# Editor and OS noise
.gitignore
.gitattributes
.editorconfig
.distignore
*.sql
.env
.env.*
*.md

# WordPress.org rejects VCS directories and these archive/script extensions anywhere in the zip.
.git
.svn
.hg
.bzr
*.phar
*.sh
*.zip
*.gz
*.tgz
*.tar
*.rar
*.7z

# Directory icons already live in .wordpress-org/. Copies under assets/ are not plugin runtime files.
assets/icon-128x128.png
assets/icon-256x256.png

# Composer CA bundle fallback. Geo Core looks up countries in the local GeoLite2
# database and downloads that file with the WordPress HTTP API. Nothing in this
# plugin constructs GeoIp2\WebService\Client, which is the only caller of
# Composer\CaBundle. The bundled cacert.pem is therefore unused and is left out
# of the directory zip. The class file stays so Composer autoload remains valid.
vendor/composer/ca-bundle/res/cacert.pem

# Guideline 8: the WordPress.org build must not contain the api.reactwoo.com updater.
# Pro add-ons ship their own updater. The ReactWoo channel zip still includes this file.
includes/class-rwgc-satellite-updater.php
