# WordPress.org package exclusions. Used by:
#   python scripts/package_zip.py --target wporg
# The ReactWoo release zip (no --target, or --target reactwoo) does not read this file.

# Version control, agent, and CI
.git
.github
.cursor
ai-handoff

# WordPress.org directory assets (icon, banner, screenshots). Not part of either plugin zip.
.wordpress-org

# Docs, tests, and maintainer tooling (not needed to run the plugin)
docs
tests
scripts
node_modules

# PHPUnit / Composer dev trees if a maintainer packaged before --no-dev
vendor/bin
vendor/phpunit
vendor/phar-io
vendor/nikic
vendor/myclabs
vendor/sebastian
vendor/theseer
vendor/doctrine

# Library examples, nested tests, docs, and maintainer scripts.
# Composer autoload does not reference these. WordPress.org also rejects .sh files.
vendor/**/examples
vendor/**/example
vendor/**/test
vendor/**/tests
vendor/**/docs
vendor/**/dev-bin
vendor/**/.github
vendor/**/.git
vendor/**/.svn
vendor/**/.hg
vendor/**/.bzr

# Project manifests. Runtime uses vendor/autoload.php, not these files.
composer.json
composer.lock
package.json
package-lock.json
pyproject.toml
phpunit.xml
phpunit.xml.dist
phpcs.xml
phpcs.xml.dist
phpcs.xml.dist.example

# Editor and OS noise
.gitignore
.gitattributes
.editorconfig
.distignore
*.sql
.env
.env.*
*.md

# WordPress.org rejects VCS directories and these archive/script extensions anywhere in the zip.
.git
.svn
.hg
.bzr
*.phar
*.sh
*.zip
*.gz
*.tgz
*.tar
*.rar
*.7z

# Guideline 8: the WordPress.org build must not contain the api.reactwoo.com updater.
# Pro add-ons ship their own updater. The ReactWoo channel zip still includes this file.
includes/class-rwgc-satellite-updater.php
