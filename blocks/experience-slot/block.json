{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "reactwoo/experience-slot",
  "title": "ReactWoo Experience Slot",
  "category": "design",
  "icon": "layout",
  "description": "Stable location for alternate experiences. Default InnerBlocks content is always the fallback.",
  "keywords": [ "reactwoo", "experience", "slot", "personalization" ],
  "textdomain": "reactwoo-geocore",
  "attributes": {
    "slotId": {
      "type": "string",
      "default": ""
    },
    "slotName": {
      "type": "string",
      "default": ""
    },
    "managementMode": {
      "type": "string",
      "default": "local"
    },
    "instanceId": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [ "wide", "full" ],
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "editorScript": "file:./editor.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css"
}
