{
  "apiVersion": 2,
  "name": "reactwoo-geocore/geo-content",
  "title": "Geo Content (ReactWoo)",
  "category": "widgets",
  "icon": "location-alt",
  "description": "Show or hide content based on visitor country and visibility rules using ReactWoo Geo Core.",
  "supports": {
    "html": false
  },
  "attributes": {
    "enableCountryTargeting": {
      "type": "boolean",
      "default": false
    },
    "countryVisibilityMode": {
      "type": "string",
      "default": "show_if"
    },
    "showCountries": {
      "type": "array",
      "default": []
    },
    "hideCountries": {
      "type": "array",
      "default": []
    },
    "enableVisibilityRules": {
      "type": "boolean",
      "default": false
    },
    "visibilityRulesMode": {
      "type": "string",
      "default": "show_if"
    },
    "portableTargeting": {
      "type": "string",
      "default": ""
    },
    "appliedVisibilityRuleId": {
      "type": "string",
      "default": ""
    },
    "visibilityRuleLibrary": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "default": "show"
    },
    "usePortableTargeting": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "rwgc-geo-content-editor",
  "editorStyle": "rwgc-geo-content-editor",
  "style": "rwgc-geo-content"
}
