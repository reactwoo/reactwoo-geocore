{
  "name": "reactwoo/reactwoo-geocore",
  "description": "Shared geolocation engine for ReactWoo products, backed by MaxMind GeoLite2.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "geoip2/geoip2": "^2.0",
    "maxmind-db/reader": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "RWGC\\": "includes/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "test:rules": "php tests/test-rule-condition-evaluator.php",
    "test:rwgc-rule-evaluator": "php tests/test-rwgc-rule-evaluator.php",
    "test:ai-snapshot": "php tests/test-rwgc-ai-snapshot.php",
    "test:contracts": "php tests/test-rwgc-contracts.php",
    "test:platform-capabilities": "php tests/test-rwgc-platform-capabilities.php",
    "test:decision-runtime": "php tests/test-rwgc-decision-runtime.php",
    "test:decision-parity": "php tests/test-rwgc-decision-parity.php",
    "test:experience-slots": "php tests/test-rwgc-experience-slots.php",
    "test:elementor-experience-slots": "php tests/test-rwgc-elementor-experience-slots.php",
    "test:gutenberg-experience-slot": "php tests/test-rwgc-gutenberg-experience-slot.php",
    "test:components": "php tests/test-rwgc-components.php",
    "test:variants": "php tests/test-rwgc-variants.php",
    "test:cloud-connector": "php tests/test-rwgc-cloud-connector.php",
    "test:entitlements": "php tests/test-rwgc-entitlements.php",
    "test:all": [
      "@test",
      "@test:rules",
      "@test:rwgc-rule-evaluator",
      "@test:ai-snapshot",
      "@test:contracts",
      "@test:platform-capabilities",
      "@test:decision-runtime",
      "@test:decision-parity",
      "@test:experience-slots",
      "@test:elementor-experience-slots",
      "@test:gutenberg-experience-slot",
      "@test:components",
      "@test:variants",
      "@test:cloud-connector",
      "@test:entitlements"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2.31"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

