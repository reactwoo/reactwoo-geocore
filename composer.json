{
  "name": "reactwoo/reactwoo-geocore",
  "description": "Shared geolocation engine for ReactWoo products, backed by MaxMind GeoLite2.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4",
    "geoip2/geoip2": "^2.0",
    "maxmind-db/reader": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "RWGC\\": "includes/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist",
    "test:rules": "php tests/test-rule-condition-evaluator.php",
    "test:page-version-routing": "php tests/test-page-version-routing.php",
    "test:portable-render-fail-closed": "php tests/test-portable-render-fail-closed.php",
    "test:rwgc-rule-evaluator": "php tests/test-rwgc-rule-evaluator.php",
    "test:all": [
      "@test",
      "@test:rules",
      "@test:page-version-routing",
      "@test:portable-render-fail-closed",
      "@test:rwgc-rule-evaluator"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2.31"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

